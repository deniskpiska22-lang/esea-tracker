{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "esea-tracker.vercel.app" }],
      "destination": "https://eseatracker.ru/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.eseatracker.ru" }],
      "destination": "https://eseatracker.ru/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ads/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/teams/:slug", "destination": "/teams/:slug.html" },
    { "source": "/players/:id", "destination": "/players/:id.html" },
    { "source": "/player/:id", "destination": "/players/:id.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
