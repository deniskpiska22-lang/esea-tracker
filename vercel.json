{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "esea-tracker.vercel.app"
        }
      ],
      "destination": "https://eseatracker.ru/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.eseatracker.ru"
        }
      ],
      "destination": "https://eseatracker.ru/:path*",
      "permanent": true
    },
    {
      "source": "/player/:key",
      "destination": "/players/:key",
      "permanent": true
    },
    {
      "source": "/team/:path*",
      "destination": "/teams/:path*",
      "permanent": true
    },
    {
      "source": "/matches/:key",
      "destination": "/match/:key",
      "permanent": true
    },
    {
      "source": "/teams/:slug/matches/:key",
      "destination": "/match/:key",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ads/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex,follow"
        }
      ]
    },
    {
      "source": "/register",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex,follow"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex,follow"
        }
      ]
    },
    {
      "source": "/profile/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex,follow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex,follow"
        }
      ]
    },
    {
      "source": "/data-status",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex,follow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo-sitemap"
    },
    {
      "source": "/sitemaps/:kind(teams|players|matches)-:page(\\d+).xml",
      "destination": "/api/seo-sitemap?kind=:kind&page=:page"
    },
    {
      "source": "/teams/:key/:section(matches|stats|analytics|veto)",
      "destination": "/api/seo-profile?kind=team&key=:key&section=:section"
    },
    {
      "source": "/teams/:key",
      "destination": "/api/seo-profile?kind=team&key=:key"
    },
    {
      "source": "/players/:key",
      "destination": "/api/seo-profile?kind=player&key=:key"
    },
    {
      "source": "/player/:key",
      "destination": "/api/seo-profile?kind=player&key=:key"
    },
    {
      "source": "/match/:key",
      "destination": "/api/seo-profile?kind=match&key=:key"
    },
    {
      "source": "/",
      "destination": "/api/seo-profile?kind=page&key=home"
    },
    {
      "source": "/rankings",
      "destination": "/api/seo-profile?kind=page&key=rankings"
    },
    {
      "source": "/matches",
      "destination": "/api/seo-profile?kind=page&key=matches"
    },
    {
      "source": "/players",
      "destination": "/api/seo-profile?kind=page&key=players"
    },
    {
      "source": "/calendar",
      "destination": "/api/seo-profile?kind=page&key=calendar"
    },
    {
      "source": "/about",
      "destination": "/api/seo-profile?kind=page&key=about"
    },
    {
      "source": "/media",
      "destination": "/api/seo-profile?kind=page&key=media"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/seo-profile.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
