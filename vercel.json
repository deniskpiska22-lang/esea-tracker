{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "esea-tracker.vercel.app"
        }
      ],
      "destination": "https://eseatracker.ru/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.eseatracker.ru"
        }
      ],
      "destination": "https://eseatracker.ru/:path*",
      "permanent": true
    },
    {
      "source": "/player/:key",
      "destination": "/players/:key",
      "permanent": true
    },
    {
      "source": "/team/:path*",
      "destination": "/teams/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ads/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo-sitemap"
    },
    {
      "source": "/sitemaps/:kind(teams|players)-:page(\\d+).xml",
      "destination": "/api/seo-sitemap?kind=:kind&page=:page"
    },
    {
      "source": "/teams/:key/:section(matches|stats|analytics|veto)",
      "destination": "/api/seo-profile?kind=team&key=:key&section=:section"
    },
    {
      "source": "/teams/:key",
      "destination": "/api/seo-profile?kind=team&key=:key"
    },
    {
      "source": "/players/:key",
      "destination": "/api/seo-profile?kind=player&key=:key"
    },
    {
      "source": "/player/:key",
      "destination": "/api/seo-profile?kind=player&key=:key"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/seo-profile.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
